{
  "name": "ai-engineering-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:offline": "tsx scripts/scrape.ts --offline",
    "build:resources": "tsx scripts/build-resources.ts",
    "build:practice": "tsx scripts/build-practice.ts",
    "build:data": "npm run scrape:offline && npm run build:resources && npm run build:practice",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "fuse.js": "^7.5.0",
    "next": "15.5.28",
    "pyodide": "0.26.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
